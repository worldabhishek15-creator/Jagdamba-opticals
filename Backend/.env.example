# .env.example - Environment variables template for Jagdamba Optical Inventory System

# Server Configuration
PORT=10000
NODE_ENV=production

# Database - PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Authentication
JWT_SECRET=replace-with-a-long-random-secret-key-min-32-chars
JWT_EXPIRY=7d

# Admin Credentials (First Login)
ADMIN_EMAIL=admin@jagdambaoptical.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!

# CORS - Frontend URLs (comma-separated for multiple)
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:3000

# Cloudinary - Image Upload (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@jagdambaoptical.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session & Security
SESSION_SECRET=replace-with-a-different-secret-key
BCRYPT_ROUNDS=12

# Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Backup & Maintenance
BACKUP_INTERVAL_DAYS=7
AUTO_BACKUP_ENABLED=true

# Feature Flags
ENABLE_IMAGE_UPLOAD=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_AUDIT_LOGS=true

# Development Only (Override in production)
# NODE_ENV=development
# DEBUG=true